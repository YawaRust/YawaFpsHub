// Абсолютный путь к иконке подставляет CMake: rc.exe ищет файлы относительно
// рабочего каталога сборки, а не каталога скрипта.
// Иконка и свойства exe. Иконка генерируется tools/make_icon.py и совпадает с той,
// что рисуется в рельсе приложения.
#pragma code_page(65001)
#include <windows.h>

101 ICON "@YAWA_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION@,0
 PRODUCTVERSION @PROJECT_VERSION@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904B0"
        BEGIN
            VALUE "CompanyName", "YawaFpsHub"
            VALUE "FileDescription", "YawaFpsHub — монитор FPS и системы"
            VALUE "FileVersion", "@PROJECT_VERSION@.0"
            VALUE "InternalName", "YawaFpsHub"
            VALUE "OriginalFilename", "YawaFpsHub.exe"
            VALUE "ProductName", "YawaFpsHub"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
