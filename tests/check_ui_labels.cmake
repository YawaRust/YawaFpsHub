file(GLOB views "${PROJECT_ROOT}/app/ui/*_view.cpp")
if(NOT views)
    message(FATAL_ERROR "Файлы экранов не найдены: ${PROJECT_ROOT}")
endif()
foreach(view IN LISTS views)
    file(STRINGS "${view}" lines)
    foreach(line IN LISTS lines)
        if(line MATCHES "L\"[^\"]*(ETW|PDH|NVML|DXGI|SMBIOS|WMI|ACPI|CPUID|EnumDisplaySettings|GetLogicalProcessorInformationEx)")
            message(FATAL_ERROR "В пользовательской подписи остался технический термин: ${view}: ${line}")
        endif()
        if(line MATCHES "L\"[^\"]*(Медианный frame time|Пропущено кадров|ПРОПУЩЕНО)")
            message(FATAL_ERROR "Неточная подпись показателя кадров: ${view}: ${line}")
        endif()
    endforeach()
endforeach()
